# Copie este arquivo para ".env" na raiz do projeto e preencha com valores
# reais. O ".env" nunca deve ser commitado (já está no .gitignore).

# --- MongoDB ---
MONGO_URI=mongodb://usuario:senha@mongo:27017/bigquery?authSource=admin
MONGO_DB=bigquery

# --- Autenticação (backend) ---
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=12h

# Usuário criado por "npm run seed:admin" dentro de backend-nest/
SEED_ADMIN_EMAIL=admin@empresa.com
SEED_ADMIN_PASSWORD=escolha-uma-senha-forte

# --- ETL (processamento de imports) ---
ETL_URL=http://etl:8001/process
ETL_TIMEOUT_MS=30000
